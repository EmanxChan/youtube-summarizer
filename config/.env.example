# Content Summarizer - Environment Variables Template
# Copy this file to .env and fill in your API keys

# Listen Notes API Key (for podcast search & episodes)
# Get your free API key at: https://www.listennotes.com/api/
LISTEN_NOTES_API_KEY="your_api_key_here"

# YouTube Data API Key (optional - for enhanced search)
# Get from: https://console.cloud.google.com/
# YOUTUBE_API_KEY="your_youtube_api_key_here"

# Ollama Settings (for local AI summarization)
# Default model to use for summarization
# OLLAMA_MODEL="mistral:instruct"

# OpenAI API Key (optional - alternative to Ollama)
# OPENAI_API_KEY="your_openai_api_key_here"
