# Content Summarizer - Environment Configuration

# REQUIRED: Groq API Key for AI summarization
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# AI Provider Configuration (optional, defaults to Groq)
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Alternative AI Providers
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Tavily Search API Key (for AI Research Assistant chat)
# Get a free key at: https://app.tavily.com
# TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Jina Reader API Key (for X/Twitter article fetching)
# Get your key at: https://jina.ai/reader - Free tier: 1M tokens/month
# If not set, Jina Reader will still work with lower rate limits
# JINA_API_KEY=your_jina_api_key_here

# Optional: Podcast Metadata
# LISTEN_NOTES_API_KEY=your_listennotes_key_here

# Optional: YouTube Data API (for metadata)
# YOUTUBE_API_KEY=your_youtube_api_key_here
