# Content Summarizer - Environment Configuration

# REQUIRED: Groq API Key for AI summarization
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# AI Provider Configuration (optional, defaults to Groq)
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Alternative AI Providers
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Podcast Metadata
# LISTEN_NOTES_API_KEY=your_listennotes_key_here

# Optional: YouTube Data API (for metadata)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: YouTube Transcript Troubleshooting
# If you're getting 403 Forbidden errors when fetching transcripts:
#
# Option 1: Export cookies from your browser (recommended)
# Use a browser extension to export cookies.txt from youtube.com
# YOUTUBE_COOKIES_PATH=/path/to/cookies.txt
#
# Option 2: Use a proxy/VPN
# YOUTUBE_PROXY=http://proxy.example.com:8080
