# Streamlit Cloud Secrets Configuration
# Copy this file to secrets.toml and fill in your API keys
# DO NOT commit secrets.toml to git!

# Required: Groq API Key (get at https://console.groq.com/keys)
GROQ_API_KEY = "your_groq_api_key_here"

# AI Provider Configuration
AI_PROVIDER = "groq"
GROQ_MODEL = "llama-3.1-8b-instant"

# Optional: Alternative AI Providers
# OPENAI_API_KEY = "your_openai_key_here"
# ANTHROPIC_API_KEY = "your_anthropic_key_here"

# Optional: Podcast Metadata (get at https://www.listennotes.com/api/)
# LISTEN_NOTES_API_KEY = "your_listennotes_key_here"

# Optional: Hugging Face API (fallback for transcription)
# Get free token at: https://huggingface.co/settings/tokens
# HF_TOKEN = "your_huggingface_token_here"

# Optional: YouTube Data API
# YOUTUBE_API_KEY = "your_youtube_api_key_here"
